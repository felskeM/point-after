---
import '../styles/global.css';
import { site } from '../data/site';
const { title = site.name, description = 'Point After Pub & Grille in Franklin, WI.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#791715" />
  </head>
  <body>
    <slot />
  </body>
</html>
