---
import { site } from '../data/site';
---
<section id="home" class="hero">
  <img src="/images/IMG_8811.jpg" alt="Flame-grilled food at Point After" class="hero-image" fetchpriority="high" />
  <div class="hero-shade"></div>
  <div class="section-shell relative z-10 flex min-h-[760px] items-end pb-20 pt-40 lg:min-h-screen lg:pb-24">
    <div class="max-w-5xl">
      <p class="eyebrow">Franklin, Wisconsin · Since 2015</p>
      <h1 class="hero-title">Your neighborhood<br/><span>home team.</span></h1>
      <p class="mt-7 max-w-2xl text-lg leading-8 text-white/80 sm:text-xl">Great food, cold drinks, and 23 screens with every seat in the action. Bring the family, meet the crew, and stay for the whole game.</p>
      <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:flex-wrap">
        <a href="#menu-new" class="btn btn-primary">Explore the Menu <span aria-hidden="true">↗</span></a>
        <a href="#events-new" class="btn btn-outline">See What’s On</a>
      </div>
    </div>
  </div>
  <a href="#menu-new" class="scroll-cue" aria-label="Scroll to menu">Scroll <span>↓</span></a>
  <div class="hero-meta"><span>{site.address}</span><span class="hidden sm:inline">•</span><a href={`tel:${site.phone}`}>{site.phone}</a></div>
</section>
