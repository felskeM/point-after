---
import { site } from '../data/site';
---
<div class="contact-options mt-6 space-y-3 leading-7">
  <p><strong>Prefer to write?</strong> Email <a class="underline break-all" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> for accessibility or communication assistance.</p>
  <p>For hearing or speech access, you can use your preferred relay service, or dial <a class="underline" href="tel:711">711</a> and ask to reach {site.phone}. This restaurant number is a voice line; text messaging is not confirmed.</p>
  <p><a class="underline" href="/accessibility/">Accessibility and communication options</a></p>
</div>
