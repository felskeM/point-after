---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';

import { hours, orderingHours, menuHighlights, site, specials } from '../data/site';
---
<BaseLayout title="Point After Pub & Grille | Franklin, WI" description="Way More Than Just a Sports Bar! Family-friendly food, drinks, and 23 screens in Franklin, Wisconsin.">
  <Header />
  <main id="main-content" tabindex="-1">
    <Hero />
    <div class="marquee" aria-hidden="true"><span>Cold Drinks • Flame-Grilled Favorites • Every Game • Good Company • Cold Drinks • Flame-Grilled Favorites • Every Game • Good Company • </span></div>

    <section id="menu-new" class="py-24 lg:py-32">
      <div class="section-shell">
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div><p class="eyebrow text-pa-primary">Our Menu</p><h2 class="display-title mt-4">Something for<br/>every appetite.</h2></div>
          <div class="max-w-2xl lg:justify-self-end"><p class="text-lg leading-8 text-pa-ink/70">From appetizers, wings, salads, and build-your-own burgers to sandwiches, wraps, Friday fish fry, and a Minor League Menu for the shorter crowd.</p><a href="/menus/point-after-main-menu-may-2026.pdf" class="card-link mt-6">Download the complete menu <span>→</span></a></div>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {menuHighlights.map((item, i) => <article class={`group relative min-h-[390px] overflow-hidden rounded-[2rem] ${i === 0 ? 'lg:col-span-2' : ''}`}>
            <img src={["/images/IMG_8819.jpg","/images/IMG_8815.jpg","/images/IMG_8856.jpg","/images/IMG_8863.jpg"][i]} alt={item.title} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-pa-ink via-pa-ink/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-7 text-white"><p class="text-[10px] font-black uppercase tracking-[.2em] text-pa-secondary">{item.price}</p><h3 class="mt-2 font-display text-4xl font-black uppercase">{item.title}</h3><p class="mt-2 max-w-md text-sm leading-6 text-white/70">{item.copy}</p></div>
          </article>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3"><a class="btn bg-pa-primary text-white hover:bg-pa-accent" href="/menus/point-after-main-menu-may-2026.pdf">Full Food Menu <span>↗</span></a><a class="btn border border-pa-primary text-pa-primary hover:bg-pa-primary hover:text-white" href="/menus/taco-tuesday-menu.pdf">Taco Tuesday Menu <span>↗</span></a></div>
      </div>
    </section>

    <section id="specials-new" class="bg-pa-primary py-24 text-white lg:py-32">
      <div class="section-shell grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="photo-card min-h-[540px]"><img src="/images/IMG_8855.jpg" alt="A Point After cocktail and shot" loading="lazy" /></div>
        <div class="lg:pl-12"><p class="eyebrow">Food & Drink Features</p><h2 class="display-title mt-4">Bring your appetite<br/>- it’s a fiesta!</h2><p class="mt-7 max-w-xl text-lg leading-8 text-white/70">Taco Tuesday at Point After features chicken, beef, shredded pork, fish, and shrimp taco platters, plus a lunch platter served from 11 AM-3 PM.</p><div class="mt-8 rounded-2xl border border-white/25 p-6"><h3 class="text-xl font-bold">Happy hour</h3><p class="mt-2 leading-7">Monday–Thursday, 3:03–6:03 PM: $2 off select tap beers, house wines, and rail mixers.</p><h3 class="mt-5 text-xl font-bold">Weekend brunch</h3><p class="mt-2 leading-7">Saturday &amp; Sunday, 10:30 AM–2:00 PM.</p></div><div class="mt-9 grid gap-3 sm:grid-cols-2">{specials.map((item) => <div class="border-t border-white/20 py-4 text-sm font-black uppercase tracking-[.12em]">{item}</div>)}</div><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/menus/taco-tuesday-menu.pdf">Taco Tuesday <span>↗</span></a><a class="btn btn-outline" href="/menus/wines-and-summer-features.pdf">Wine Features <span>↗</span></a></div></div>
      </div>
    </section>

    <section id="events-new" class="py-24 lg:py-32"><div class="section-shell"><div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-center"><div><p class="eyebrow text-pa-primary">More Than a Sports Bar</p><h2 class="display-title mt-4">Never a bad seat<br/>in the house.</h2><p class="mt-6 max-w-lg leading-7 text-pa-ink/70">With 23 flat screens strategically placed throughout the restaurant, Point After is the place for viewing sports - and ignoring your friends!</p><a href="/luxury-box/" class="btn mt-7 bg-pa-primary text-white hover:bg-pa-accent">Explore the Luxury Box <span aria-hidden="true">→</span></a></div><div class="grid grid-cols-2 gap-4"><div class="photo-card mt-12 h-[420px]"><img src="/images/_MG_0077.jpg" alt="Cornhole players at Point After" loading="lazy" /></div><div class="photo-card h-[420px]"><img src="/images/_MG_0107.jpg" alt="Point After community gathering" loading="lazy" /></div></div></div></div></section>

    <section id="parties-new" class="relative isolate min-h-[650px] overflow-hidden text-white"><img src="/images/IMG_8820.jpg" alt="Point After dining room" class="absolute inset-0 -z-20 h-full w-full object-cover" loading="lazy" /><div class="absolute inset-0 -z-10 bg-pa-ink/70"></div><div class="section-shell flex min-h-[650px] items-center justify-center py-24 text-center"><div class="max-w-4xl"><p class="eyebrow">Bring the whole crew</p><h2 class="display-title mt-5 lg:text-8xl">Your crew.<br/>Our Luxury Box.</h2><p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-white/75">Host up to 50 guests in the Luxury Box, with seven big-screen TVs, including a 75-inch screen. Choose full dinner service, a buffet, appetizers, or a custom menu for birthdays, team dinners, meetings, and fantasy drafts. Call to discuss availability.</p><a href={`tel:${site.phone}`} class="btn btn-primary mt-9">Plan a Gathering <span>→</span></a></div></div></section>

    <section id="contact-new" class="bg-pa-cream py-24 lg:py-32"><div class="section-shell grid gap-12 lg:grid-cols-[1.1fr_.9fr] lg:items-start"><div><img src="/brand/main-logo.png" alt="Point After Pub & Grille" class="w-64 max-w-full" /><h2 class="display-title mt-10">Get to<br/><span class="text-pa-primary">The Point.</span></h2></div><div class="rounded-[2rem] bg-pa-ink p-8 text-white sm:p-10"><p class="eyebrow">Visit Us</p><a href={site.mapsUrl} class="mt-5 block font-display text-3xl font-black uppercase leading-tight hover:text-pa-secondary">{site.address}</a><a href={`tel:${site.phone}`} class="mt-7 block text-xl font-bold text-pa-secondary">{site.phone}</a><div class="mt-8 border-t border-white/15 pt-8">
  <h3 class="text-xl font-bold">Restaurant hours</h3>
  <dl class="mt-4 space-y-3">{hours.map((item) => <div class="flex flex-wrap justify-between gap-x-4 gap-y-1"><dt>{item.days}</dt><dd class="font-bold text-pa-secondary">{item.time}</dd></div>)}</dl>
  <p class="mt-4 text-sm leading-6 text-white/80">All times Central. Call for today’s closing time, kitchen availability, and holiday hours.</p>
  <h3 class="mt-7 text-xl font-bold">Online-order hours</h3>
  <dl class="mt-4 space-y-3 text-sm">{orderingHours.map((item) => <div class="flex flex-wrap justify-between gap-x-4 gap-y-1"><dt>{item.days}</dt><dd>{item.time}</dd></div>)}</dl>
  <p class="mt-3 text-sm leading-6 text-white/80">Online-order hours differ from restaurant hours. Call for ordering assistance.</p>
  </div><div class="mt-8 border-t border-white/15 pt-8 text-sm leading-7 text-white/80"><p>Family-friendly dining · Full-service bar</p><p>23 screens · Never a bad seat in the house</p></div><a href={site.mapsUrl} class="btn btn-primary mt-8">Get Directions <span>↗</span></a></div></div></section>
    <section id="community" class="section-shell grid gap-8 py-16 md:grid-cols-2">
      <div><h2 class="text-2xl font-black text-pa-primary">Touchback Program</h2><p class="mt-3 leading-7">Bring your nonprofit together for an event that gives back to the community.</p><a href="/touchback-program/" class="card-link mt-4">Explore the Touchback Program →</a></div>
      <div><h2 class="text-2xl font-black text-pa-primary">Work with us</h2><p class="mt-3 leading-7">For current job openings and how to apply, contact the restaurant at <a class="underline" href={`tel:${site.phone}`}>{site.phone}</a>.</p></div>
    </section>
  </main>

  <footer class="bg-pa-ink py-10 text-white/60">
    <div class="section-shell flex flex-col gap-4 text-sm md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} Point After Pub & Grille. All rights reserved.</p>
      <nav class="flex flex-wrap gap-5" aria-label="Footer"><a href="/privacy/" class="underline">Privacy</a><a href="/accessibility/" class="underline">Accessibility</a><a href="#contact-new" class="underline">Hours &amp; contact</a></nav>
    </div>
  </footer>
</BaseLayout>
