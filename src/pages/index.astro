---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { menuHighlights, site, specials } from '../data/site';
---
<BaseLayout title="Point After Pub & Grille | Franklin, WI" description="Way More Than Just a Sports Bar! Family-friendly food, drinks, and 23 screens in Franklin, Wisconsin.">
  <Header />
  <Hero />

  <main class="hidden">
    <section id="menu" class="py-24">
      <div class="section-shell">
        <SectionHeading eyebrow="Food & Drink" title="Pub classics with a polished digital menu experience." copy="Use this section for high-margin favorites, updated PDFs, online menu embeds, or manually-managed menu cards." />
        <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
          {menuHighlights.map((item) => (
            <article class="rounded-[2rem] border border-pa-taupe/20 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-glow">
              <p class="text-xs font-black uppercase tracking-[0.25em] text-pa-accent">{item.price}</p>
              <h3 class="mt-4 font-display text-3xl font-black text-pa-primary">{item.title}</h3>
              <p class="mt-4 leading-7 text-pa-ink/70">{item.copy}</p>
            </article>
          ))}
        </div>
        <div class="mt-10 flex flex-wrap gap-4">
          <a class="btn bg-pa-primary text-white hover:bg-pa-accent" href="/menu.pdf">Download Menu</a>
          <a class="btn border border-pa-primary text-pa-primary hover:bg-pa-primary hover:text-white" href="#contact">Ask About Specials</a>
        </div>
      </div>
    </section>

    <section id="specials" class="bg-pa-ink py-24 text-white">
      <div class="section-shell grid gap-12 lg:grid-cols-[.9fr_1.1fr] lg:items-center">
        <div class="placeholder-img border-white/20 bg-white/5 text-white/50">Specials / wings / drinks image placeholder</div>
        <div>
          <SectionHeading eyebrow="Specials" title="Make repeat visits easy." copy="The older site has events and food content; this modern layout makes specials feel current without needing a full custom CMS right away." />
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {specials.map((item) => <div class="rounded-3xl border border-white/10 bg-white/5 p-5 font-bold">{item}</div>)}
          </div>
        </div>
      </div>
    </section>

    <section id="events" class="py-24">
      <div class="section-shell grid gap-10 lg:grid-cols-3">
        <div class="lg:col-span-1"><SectionHeading eyebrow="Events" title="Game days, calendars, and community nights." /></div>
        <div class="grid gap-6 lg:col-span-2 md:grid-cols-2">
          <div class="rounded-[2rem] bg-pa-primary p-8 text-white">
            <p class="eyebrow">Sports</p>
            <h3 class="mt-4 font-display text-4xl font-black">Watch parties</h3>
            <p class="mt-4 text-white/75">Create cards for Packers, Bucks, Brewers, UFC, trivia, or live music nights.</p>
          </div>
          <div class="rounded-[2rem] bg-pa-secondary p-8 text-pa-ink">
            <p class="text-xs font-black uppercase tracking-[0.35em] text-pa-primary">Calendar</p>
            <h3 class="mt-4 font-display text-4xl font-black">Event feed</h3>
            <p class="mt-4 text-pa-ink/75">Swap this with Google Calendar, manual Markdown, or a lightweight CMS later.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="parties" class="overflow-hidden bg-pa-taupe/20 py-24">
      <div class="section-shell grid gap-12 lg:grid-cols-2 lg:items-center">
        <div>
          <SectionHeading eyebrow="Private Events" title="Give groups a reason to book." copy="Inspired by modern restaurant sites: strong copy, warm images, and clear CTAs for birthdays, teams, fantasy drafts, company outings, and family gatherings." />
          <a class="btn mt-8 bg-pa-accent text-white hover:bg-pa-primary" href={`tel:${site.phone}`}>Plan an Event</a>
        </div>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="placeholder-img min-h-[320px]">Private party image placeholder</div>
          <div class="placeholder-img min-h-[320px] translate-y-8">Bar / tables image placeholder</div>
        </div>
      </div>
    </section>

    <section id="contact" class="bg-pa-primary py-24 text-white">
      <div class="section-shell grid gap-10 lg:grid-cols-[1fr_.85fr] lg:items-start">
        <div>
          <p class="eyebrow">Visit Us</p>
          <h2 class="mt-4 font-display text-5xl font-black">Get to The Point.</h2>
          <p class="mt-5 max-w-xl text-lg leading-8 text-white/75">Add real hours, social links, online ordering, and a Google Maps embed once you confirm final business info.</p>
          <div class="mt-8 space-y-3 text-white/80">
            <p><strong class="text-pa-secondary">Address:</strong> {site.address}</p>
            <p><strong class="text-pa-secondary">Phone:</strong> <a href={`tel:${site.phone}`}>{site.phone}</a></p>
            <p><strong class="text-pa-secondary">Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
          </div>
        </div>
        <div class="rounded-[2rem] border border-white/10 bg-white/10 p-6">
          <div class="placeholder-img min-h-[340px] border-white/20 bg-white/5 text-white/50">Google map embed placeholder</div>
        </div>
      </div>
    </section>
  </main>

  <main>
    <div class="marquee" aria-hidden="true"><span>Cold Drinks • Flame-Grilled Favorites • Every Game • Good Company • Cold Drinks • Flame-Grilled Favorites • Every Game • Good Company • </span></div>

    <section id="menu-new" class="py-24 lg:py-32">
      <div class="section-shell">
        <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-end">
          <div><p class="eyebrow text-pa-primary">Our Menu</p><h2 class="display-title mt-4">Something for<br/>every appetite.</h2></div>
          <div class="max-w-2xl lg:justify-self-end"><p class="text-lg leading-8 text-pa-ink/70">From appetizers, wings, salads, and build-your-own burgers to sandwiches, wraps, Friday fish fry, and a Minor League Menu for the shorter crowd.</p><a href="/menus/point-after-main-menu-may-2026.pdf" class="card-link mt-6">Download the complete menu <span>→</span></a></div>
        </div>
        <div class="mt-14 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
          {menuHighlights.map((item, i) => <article class={`group relative min-h-[390px] overflow-hidden rounded-[2rem] ${i === 0 ? 'lg:col-span-2' : ''}`}>
            <img src={["/images/IMG_8819.jpg","/images/IMG_8815.jpg","/images/IMG_8856.jpg","/images/IMG_8863.jpg"][i]} alt={item.title} class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-pa-ink via-pa-ink/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-7 text-white"><p class="text-[10px] font-black uppercase tracking-[.2em] text-pa-secondary">{item.price}</p><h3 class="mt-2 font-display text-4xl font-black uppercase">{item.title}</h3><p class="mt-2 max-w-md text-sm leading-6 text-white/70">{item.copy}</p></div>
          </article>)}
        </div>
        <div class="mt-8 flex flex-wrap gap-3"><a class="btn bg-pa-primary text-white hover:bg-pa-accent" href="/menus/point-after-main-menu-may-2026.pdf">Full Food Menu <span>↗</span></a><a class="btn border border-pa-primary text-pa-primary hover:bg-pa-primary hover:text-white" href="/menus/taco-tuesday-menu.pdf">Taco Tuesday Menu <span>↗</span></a></div>
      </div>
    </section>

    <section id="specials-new" class="bg-pa-primary py-24 text-white lg:py-32">
      <div class="section-shell grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="photo-card min-h-[540px]"><img src="/images/IMG_8855.jpg" alt="A Point After cocktail and shot" loading="lazy" /></div>
        <div class="lg:pl-12"><p class="eyebrow">Food & Drink Features</p><h2 class="display-title mt-4">Bring your appetite<br/>- it’s a fiesta!</h2><p class="mt-7 max-w-xl text-lg leading-8 text-white/70">Taco Tuesday at Point After features chicken, beef, shredded pork, fish, and shrimp taco platters, plus a lunch platter served from 11 AM-3 PM.</p><div class="mt-9 grid gap-3 sm:grid-cols-2">{specials.map((item) => <div class="border-t border-white/20 py-4 text-sm font-black uppercase tracking-[.12em]">{item}</div>)}</div><div class="mt-8 flex flex-wrap gap-3"><a class="btn btn-primary" href="/menus/taco-tuesday-menu.pdf">Taco Tuesday <span>↗</span></a><a class="btn btn-outline" href="/menus/wines-and-summer-features.pdf">Wine Features <span>↗</span></a></div></div>
      </div>
    </section>

    <section id="events-new" class="py-24 lg:py-32"><div class="section-shell"><div class="grid gap-8 lg:grid-cols-[.75fr_1.25fr] lg:items-center"><div><p class="eyebrow text-pa-primary">More Than a Sports Bar</p><h2 class="display-title mt-4">Never a bad seat<br/>in the house.</h2><p class="mt-6 max-w-lg leading-7 text-pa-ink/70">With 23 flat screens strategically placed throughout the restaurant, Point After is the place for viewing sports - and ignoring your friends!</p></div><div class="grid grid-cols-2 gap-4"><div class="photo-card mt-12 h-[420px]"><img src="/images/_MG_0077.jpg" alt="Cornhole players at Point After" loading="lazy" /></div><div class="photo-card h-[420px]"><img src="/images/_MG_0107.jpg" alt="Point After community gathering" loading="lazy" /></div></div></div></div></section>

    <section id="parties-new" class="relative isolate min-h-[650px] overflow-hidden text-white"><img src="/images/IMG_8820.jpg" alt="Point After dining room" class="absolute inset-0 -z-20 h-full w-full object-cover" loading="lazy" /><div class="absolute inset-0 -z-10 bg-pa-ink/70"></div><div class="section-shell flex min-h-[650px] items-center justify-center py-24 text-center"><div class="max-w-4xl"><p class="eyebrow">Bring the whole crew</p><h2 class="display-title mt-5 lg:text-8xl">Good times are<br/>better together.</h2><p class="mx-auto mt-7 max-w-2xl text-lg leading-8 text-white/75">Birthdays, team dinners, fantasy drafts, and no-reason-needed get-togethers. Tell us what you’re planning.</p><a href={`tel:${site.phone}`} class="btn btn-primary mt-9">Plan a Gathering <span>→</span></a></div></div></section>

    <section id="contact-new" class="bg-pa-cream py-24 lg:py-32"><div class="section-shell grid gap-12 lg:grid-cols-[1.1fr_.9fr] lg:items-start"><div><img src="/brand/main-logo.png" alt="Point After Pub & Grille" class="w-64 max-w-full" /><h2 class="display-title mt-10">Get to<br/><span class="text-pa-primary">The Point.</span></h2></div><div class="rounded-[2rem] bg-pa-ink p-8 text-white sm:p-10"><p class="eyebrow">Visit Us</p><a href={site.mapsUrl} class="mt-5 block font-display text-3xl font-black uppercase leading-tight hover:text-pa-secondary">{site.address}</a><a href={`tel:${site.phone}`} class="mt-7 block text-xl font-bold text-pa-secondary">{site.phone}</a><div class="mt-8 border-t border-white/15 pt-8 text-sm leading-7 text-white/65"><p>Family-friendly dining · Full-service bar</p><p>23 screens · Never a bad seat in the house</p></div><a href={site.mapsUrl} class="btn btn-primary mt-8">Get Directions <span>↗</span></a></div></div></section>
  </main>

  <footer class="bg-pa-ink py-10 text-white/60">
    <div class="section-shell flex flex-col gap-4 text-sm md:flex-row md:items-center md:justify-between">
      <p>© {new Date().getFullYear()} Point After Pub & Grille. All rights reserved.</p>
      <img src="/brand/tag-logo.png" alt="Point After" class="h-12 w-auto" />
    </div>
  </footer>
</BaseLayout>
