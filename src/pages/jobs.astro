---
import ContentLayout from '../layouts/ContentLayout.astro';
import ContactOptions from '../components/ContactOptions.astro';
import { site } from '../data/site';
const positions = ['Bartender', 'Server', 'Serving Assistant', 'Dishwasher/Bus', 'Cook'];
---
<ContentLayout title="Jobs" description="Join the PA Team: inquire about bartender, server, serving assistant, dishwasher/bus and cook positions." eyebrow="Join the PA Team!" heading="So you want to work at The Point After?">
  <div class="mt-10 max-w-3xl space-y-6 text-lg leading-8">
    <h2 class="text-3xl font-black text-pa-primary">Join the PA Team!</h2>
    <p>Are you Fun? Energetic? Are you a team player who likes to wear a lot of hats? Do you like providing great customer service with a friendly smile?</p>
    <p>Then we want to meet you at The Point! Experience is preferred but not required - a Great personality will go a long way here!</p>
    <p>We're always looking to consider people with the above skills for bartenders, servers, serving assistants, dishwashers and cooks.</p>
    <p><strong>Fill out the Form Below</strong> and send us your info. Then - Get to The Point!</p>
  </div>
  <section class="mt-12 max-w-3xl rounded-3xl border border-pa-taupe bg-white p-6 sm:p-10" aria-labelledby="application-heading">
    <h2 id="application-heading" class="text-2xl font-black text-pa-primary">I am Interested in becoming a part of the PA Team!</h2>
    <p class="mt-4 leading-7">Fields marked “required” must be completed. Phone and résumé are optional. Email is available as a contact preference; a voice call is not required.</p>
    <div class="mt-5 rounded-xl bg-pa-cream p-5 leading-7" id="application-privacy">
      <p>Your information is used to review your employment inquiry and reply. Applications are delivered to <a class="underline break-all" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>, our temporary application inbox, through our hosting and email delivery providers.</p>
      <p class="mt-3">Do not include Social Security numbers, date of birth, payment details, medical information, or identity documents. No account or marketing signup is required. <a class="underline" href="/privacy/#job-applications">Read how application information is handled.</a></p>
    </div>
    <p id="form-availability" class="form-status mt-6" role="status">Online submission requires JavaScript and an available email delivery service. You can also email your interest and résumé to <a class="underline break-all" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.</p>
    <form id="jobs-form" action="/api/jobs" method="post" enctype="multipart/form-data" aria-describedby="application-privacy" class="mt-8 space-y-6">
      <div id="form-errors" class="form-status" tabindex="-1" hidden><h3 class="font-bold">Please check your application</h3><ul class="mt-3 list-inside list-disc"></ul></div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div class="form-field"><label for="first-name">First name (required)</label><input id="first-name" name="firstName" autocomplete="given-name" maxlength="80" required aria-describedby="first-name-error" /><p id="first-name-error" class="field-error" hidden></p></div>
        <div class="form-field"><label for="last-name">Last name (required)</label><input id="last-name" name="lastName" autocomplete="family-name" maxlength="80" required aria-describedby="last-name-error" /><p id="last-name-error" class="field-error" hidden></p></div>
      </div>
      <div class="form-field"><label for="email">Email (required)</label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="email-error" /><p id="email-error" class="field-error" hidden></p></div>
      <div class="form-field"><label for="phone">Phone number (optional)</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" aria-describedby="phone-error" /><p id="phone-error" class="field-error" hidden></p></div>
      <div class="form-field"><label for="contact-preference">Preferred contact method</label><select id="contact-preference" name="contactPreference" aria-describedby="contact-preference-error"><option>Email</option><option>Phone</option><option>Relay service</option></select><p id="contact-preference-error" class="field-error" hidden></p></div>
      <fieldset><legend>Position(s) you are inquiring about (optional)</legend><div class="mt-3 grid gap-2 sm:grid-cols-2">{positions.map((position, index) => <label class="check-label" for={`position-${index}`}><input type="checkbox" id={`position-${index}`} name="positions" value={position} />{position}</label>)}</div></fieldset>
      <div class="form-field"><label for="resume">Upload your résumé (PDF only, optional)</label><input id="resume" name="resume" type="file" accept=".pdf,application/pdf" aria-describedby="resume-hint resume-error" /><p id="resume-hint">Maximum file size: 3 MB. You can describe your experience below instead.</p><p id="resume-error" class="field-error" hidden></p></div>
      <div class="form-field"><label for="comments">Comments / Statement of Experience (optional)</label><textarea id="comments" name="comments" maxlength="4000" rows="7" aria-describedby="comments-hint comments-error"></textarea><p id="comments-hint">Up to 4,000 characters. You may describe a preferred communication method without sharing a diagnosis or medical details.</p><p id="comments-error" class="field-error" hidden></p></div>
      <div hidden aria-hidden="true"><label for="website">Leave this field empty</label><input id="website" name="website" tabindex="-1" autocomplete="off" /></div>
      <button id="application-submit" type="submit" class="btn bg-pa-primary text-white hover:bg-pa-accent" disabled>Send application</button>
      <p id="submission-status" role="status" aria-live="polite" class="leading-7"></p>
    </form>
    <noscript><p class="mt-5 leading-7">The online form needs JavaScript. You can apply by emailing <a class="underline break-all" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> with your name, interested positions and experience. A PDF résumé is optional.</p></noscript>
  </section>
  <section class="mt-10 max-w-3xl" aria-labelledby="application-assistance"><h2 id="application-assistance" class="text-2xl font-black">Application assistance</h2><ContactOptions /></section>
  <script src="../scripts/jobs-client.ts"></script>
</ContentLayout>
